&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

Функция Статус() Экспорт

	Процесс = СоздатьПроцесс(КоманднаяСтрока("status all -Json"), , Истина);
	Процесс.Запустить();

	Вывод = Новый Массив;
	Пока Не Процесс.Завершен Или Процесс.ПотокВывода.ЕстьДанные Цикл
		Приостановить(50);
		Вывод.Добавить(Процесс.ПотокВывода.Прочитать());
	КонецЦикла;

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(СокрЛП(СтрСоединить(Вывод, "")));
		Результат = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Результат = Новый Соответствие;
		Результат.Вставить("items", Новый Массив);
	КонецПопытки;

	Возврат Результат;

КонецФункции

Процедура ВФоне(Аргументы) Экспорт
	СоздатьПроцесс(КоманднаяСтрока(Аргументы)).Запустить();
КонецПроцедуры

Функция ДопустимаяЦель(Цель) Экспорт
	Возврат СтрРазделить("all,forti,cisco,l2tp,proxy,dns", ",").Найти(Цель) <> Неопределено;
КонецФункции

Функция КоманднаяСтрока(Аргументы)
	Скрипт = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "vpn.ps1");
	Возврат СтрШаблон("powershell -NoProfile -ExecutionPolicy Bypass -File ""%1"" %2", Скрипт, Аргументы);
КонецФункции
