&Пластилин Перем Команды;

Перем Отображения;
Перем Защита;

&Контроллер("/")
Процедура ПриСозданииОбъекта()
	Каталог = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "view");
	Отображения = View.СоздатьОтображения(Каталог, Новый Структура("Макет", "layout"));
	Защита = View.СоздатьЗащитуCSRF(ПолучитьПеременнуюСреды("DASHBOARD_SECRET"), 7 * 24 * 3600);
КонецПроцедуры

&ТочкаМаршрута("")
&НеВыводитОтображениеКонтроллера
Процедура Главная(Ответ) Экспорт
	Модель = МодельТаблицы();
	Модель.Вставить("Скрипты", View.ТегиПодключения("/static"));
	Модель.Вставить("ТокенCSRF", Защита.СоздатьТокен(Сессия()));
	Модель.Вставить("Таблица", Отображения.Фрагмент("rows", Модель));
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Отображения.Страница("index", Модель);
КонецПроцедуры

&ТочкаМаршрута("rows")
&НеВыводитОтображениеКонтроллера
Процедура Таблица(Ответ) Экспорт
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Отображения.Фрагмент("rows", МодельТаблицы());
КонецПроцедуры

&ТочкаМаршрута("do/{action}/{target}")
&НеВыводитОтображениеКонтроллера
Процедура Действие(Запрос, Ответ, МетодЗапроса, action, target) Экспорт

	Если МетодЗапроса <> "POST"
		Или Не Защита.ПроверитьТокен(Защита.ТокенИзЗаголовков(Запрос.Заголовки), Сессия()) Тогда
		Ответ.УстановитьСостояние(403);
		Возврат;
	КонецЕсли;

	Если (action <> "up" И action <> "down") Или Не Команды.ДопустимаяЦель(target) Тогда
		Ответ.УстановитьСостояние(400);
		Возврат;
	КонецЕсли;

	Команды.ВФоне(action + " " + target);

	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Отображения.Фрагмент("rows", МодельТаблицы(Истина));

КонецПроцедуры

&ТочкаМаршрута("static/{ИмяФайла}")
&НеВыводитОтображениеКонтроллера
Процедура Библиотека(ИмяФайла, Ответ) Экспорт
	Попытка
		Текст = View.СодержимоеБиблиотеки(ИмяФайла);
	Исключение
		Ответ.УстановитьСостояние(404);
		Возврат;
	КонецПопытки;
	Ответ.УстановитьТипКонтента("js");
	Ответ.ТелоТекст = Текст;
КонецПроцедуры

Функция МодельТаблицы(Занято = Ложь)

	Статус = Команды.Статус();
	Состояния = Новый Соответствие;
	Для Каждого Элемент Из Статус["items"] Цикл
		Состояния.Вставить(Элемент["id"], Элемент["state"]);
	КонецЦикла;

	Строки = Новый Массив;
	Поднято = 0;
	Для Каждого Цель Из Цели() Цикл
		Состояние = Состояния[Цель.Ид];
		Если Состояние = "up" Тогда
			Поднято = Поднято + 1;
		КонецЕсли;
		Строки.Добавить(Новый Структура("Ид,Имя,Состояние", Цель.Ид, Цель.Имя, Состояние));
	КонецЦикла;

	Если Поднято = Строки.Количество() Тогда
		КлассВсех = "up";
	ИначеЕсли Поднято = 0 Тогда
		КлассВсех = "stopped";
	Иначе
		КлассВсех = "connecting";
	КонецЕсли;

	Модель = Новый Структура;
	Модель.Вставить("Строки", Строки);
	Модель.Вставить("Все", СтрШаблон("%1/%2", Поднято, Строки.Количество()));
	Модель.Вставить("КлассВсех", КлассВсех);
	Модель.Вставить("СистемныйПрокси", ?(Статус["system_proxy"] = Истина, "up", "stopped"));
	Модель.Вставить("Блок", ?(Занято Или Статус["busy"] = Истина, " disabled", ""));
	Возврат Модель;

КонецФункции

Функция Цели()
	Список = Новый Массив;
	Список.Добавить(Новый Структура("Ид,Имя", "forti", "Forti"));
	Список.Добавить(Новый Структура("Ид,Имя", "cisco", "Cisco"));
	Список.Добавить(Новый Структура("Ид,Имя", "l2tp", "L2TP"));
	Список.Добавить(Новый Структура("Ид,Имя", "proxy", "Proxy 127.0.0.1:1080"));
	Возврат Список;
КонецФункции

Функция Сессия()
	Возврат "dashboard";
КонецФункции
